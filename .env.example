# 청소로봇 통합관제 — 환경변수 예시 (비밀값은 넣지 않는다. 실제 값은 서버 비밀 설정에만 보관)
# 로컬: 이 파일을 .env.local 로 복사해서 사용한다. .env* 는 git 에 커밋되지 않는다.
# 운영(Docker Compose): .env 파일로 두고 서버 밖으로 내보내지 않는다.

# ---- 환경 구분 ----
APP_ENV=development            # development | staging | production
APP_BASE_URL=http://localhost:3000   # 초대 링크·콜백 URL 생성에 사용. 운영: https://widebot.kro.kr
# 운영(docker compose + Caddy): 공개 도메인과 인증서 발급 알림용 이메일(Let's Encrypt/ZeroSSL 계정)
DOMAIN=widebot.kro.kr
ACME_EMAIL=

# ---- 데이터베이스 (PostgreSQL 16) ----
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/robot_control
DATABASE_URL_TEST=postgresql://postgres:postgres@127.0.0.1:5432/robot_control_test
DATABASE_POOL_MAX=10

# ---- 세션 ----
SESSION_IDLE_HOURS=12          # 마지막 활동 후 만료
SESSION_ABSOLUTE_DAYS=30       # 로그인 후 최대 유지
LOGIN_MAX_FAILURES=5           # 연속 실패 시 잠금
LOGIN_LOCK_MINUTES=15

# ---- 샘플 데이터 ----
# true 이면 관리 설정 화면의 "샘플 데이터 초기화" 버튼이 동작한다. 운영에서는 false.
ALLOW_SAMPLE_RESET=true
# 샘플 사용자 공통 비밀번호(개발 전용). 운영 DB 에는 샘플 사용자를 넣지 않는다.
SAMPLE_USER_PASSWORD=sample1234!

# ---- 제조사 어댑터 모드: sample(기본, 시뮬레이션) | live(3단계 이후) ----
VENDOR_MODE=sample
# 샘플 시뮬레이션 틱 주기(초). 워커 프로세스에서 사용.
SIMULATION_TICK_SECONDS=2

# ---- CenoBots / CZ Robots Open API (docs/22, 조회 전용) ----
# CENOBOTS_MODE: unconfigured(끔) | mock(키 없이 내부 픽스처, 운영 서버에서는 DB 적재 안 함) | live(아래 키 필요). 문제 시 unconfigured 로 바꾸고 재시작하면 코드 롤백 없이 꺼진다.
CENOBOTS_MODE=
# 리전 호스트(apac | eu | us | other 또는 https://… 전체 주소). APAC = https://app-server-apac.cz-robots.com
CENOBOTS_HOST=
CENOBOTS_ACCESS_KEY=
CENOBOTS_SECRET_KEY=
# 허용 장비(deviceOpenId 또는 번호판, 쉼표 구분). 목록 밖 장비는 조회·적재하지 않는다. 예: L4-05408,L4-05590
CENOBOTS_ALLOWED_DEVICE_OPEN_IDS=
# 웹훅 구독 시크릿(업체 콘솔에서 구독 생성 시 1회 표시). 웹훅을 쓸 때만.
CENOBOTS_WEBHOOK_SECRET=
# 선택: 주기·조회 창·서명 규칙
CENOBOTS_POLL_STATUS_SECONDS=60
CENOBOTS_POLL_REPORTS_MINUTES=10
CENOBOTS_POLL_CATALOG_MINUTES=60
CENOBOTS_POLL_WINDOW_HOURS=48
CENOBOTS_PAGE_INDEX_BASE=1
CENOBOTS_SIGN_WITH_QUERY=false
# ---- BIB (문서·키 수령 후 확정: BIB_MODE, BIB_BASE_URL, BIB_APP_KEY, BIB_APP_SECRET, BIB_ALLOWED_SNS) ----

# ---- 배송로봇 도착 알림(PUDU 에이전트, docs/23) ----
# PUDU_AGENT_MODE: unconfigured(끔) | mock(에이전트 없이 시험) | live. 끄려면 unconfigured 로 바꾸고 재시작.
PUDU_AGENT_MODE=
PUDU_AGENT_URL=http://pudu-agent:9050
PUDU_AGENT_BIN=PuduRobotOpenServer-linux
# 업체가 준 장치 ID·비밀키·리전(비밀키는 여기에만. 문서·대화에 붙이지 않는다)
PUDU_AGENT_DEVICE_ID=
PUDU_AGENT_DEVICE_SECRET=
PUDU_AGENT_REGION=
# 에이전트 → 우리 앱 알림 주소의 토큰(아무 긴 무작위 문자열)
PUDU_AGENT_NOTIFY_TOKEN=
# 도착 후 이 시간(분) 안에 완료가 없으면 재알림(0=끔)
PUDU_AGENT_REMIND_MINUTES=3

# 에이전트 → 우리 앱 알림 주소의 기준(에이전트가 점 없는 호스트명을 거부 — 운영은 공개 주소 https://<도메인>)
PUDU_AGENT_NOTIFY_BASE=
# 막힘 알림 기준(분)
PUDU_AGENT_STUCK_MINUTES=2

# ---- 카카오 알림톡(솔라피, docs/23 6장) ----
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 카카오 채널(발신 프로필) ID — 솔라피 콘솔에서 채널 연결 후 표시
SOLAPI_PFID=
# 검수된 템플릿 ID: {"DELIVERY_ARRIVED":"KA01TP…","DELIVERY_REMIND":"…","DELIVERY_CANCEL":"…","DELIVERY_PROBLEM":"…"}
SOLAPI_TEMPLATES=
# 선택: 알림톡 실패 시 문자 대체 발송 번호(솔라피 등록 발신번호). 비우면 대체 발송 안 함
SOLAPI_SENDER=

# ---- PUDU Cloud API (docs/06-PUDU-API-검토.md) ----
# VENDOR_MODE=live 이고 아래 세 값이 있으면 PUDU 로봇은 실제 API 로 동작한다. PUDU_MODE 로 PUDU 만 따로 sample/live 지정 가능.
# 클러스터: cn | sea(일본·한국·싱가포르) | de | us — 발급 계정의 클러스터를 확인해서 입력(기본값 없음)
PUDU_MODE=
PUDU_API_CLUSTER=
PUDU_API_APP_KEY=
PUDU_API_APP_SECRET=
# 허용 매장 shop_id (콤마 구분). 대리점 키는 다른 고객사의 매장·로봇까지 모두 보이므로 우리 매장만 적는다. 없으면 live 로 켜지지 않는다.
# 찾기: npm run pudu:check -- --shops 포스코
PUDU_SHOP_IDS=
# 콜백 수신: 대리점 플랫폼에 https://<도메인>/api/webhooks/pudu 를 등록하면 PUDU 가 callback_code 를 돌려준다 → 아래에(docs/05 3-3-2). 등록 전엔 비워 둔다(폴링만 동작)
PUDU_CALLBACK_CODE=
# 폴링 주기(운영 설정값). 통계 API 는 동시 1건 제한이 있어 너무 짧게 두지 않는다.
PUDU_POLL_STATUS_SECONDS=60
PUDU_POLL_REPORTS_MINUTES=10
PUDU_POLL_CATALOG_MINUTES=60
PUDU_POLL_WINDOW_HOURS=48
PUDU_API_LANGUAGE=ko-KR
PUDU_API_TIMEOUT_MS=15000
# ---- 운영 보조 ----
# 워커 하트비트가 이 초를 넘기면 /api/health 가 worker=stale 로 알린다
WORKER_HEARTBEAT_STALE_SECONDS=180
# 처리 끝난 콜백 원문 보관 일수(0 이면 삭제 안 함)
RETENTION_VENDOR_EVENTS_DAYS=30
# 같은 로봇·같은 코드의 반복 장애를 한 건으로 묶는 시간(시간)
INCIDENT_GROUP_HOURS=6
# 보고서 초안 자동 작성(기본 끔 — 담당자가 실적·보고서 화면 일정표의 버튼으로 만든다). true 면 워커가 기간 다음 날 06시에 만든다.
REPORT_AUTO_DRAFT=false

# ---- 알림 발송 (5단계, 공급사 미정) ----
NOTIFY_EMAIL_PROVIDER=mock
NOTIFY_KAKAO_PROVIDER=mock

# ---- 알림(이메일·카카오톡) ----
# 이메일: AWS SES(ap-southeast-2). live 가 아니면 모의 발송으로 기록만 한다.
MAIL_MODE=mock
MAIL_FROM="청소로봇 관제 <noreply@widebot.kro.kr>"
SES_REGION=ap-southeast-2
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# 카카오톡(나에게 보내기): developers.kakao.com 앱의 REST API 키·클라이언트 시크릿. 리다이렉트 URI = APP_BASE_URL/api/kakao/callback
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# DB 에 두는 카카오 토큰 암호화 키(32바이트 base64, openssl rand -base64 32). 바꾸면 사용자가 다시 연결해야 한다.
TOKEN_ENCRYPTION_KEY=
# 폴링으로 받은 장애 중 발생 후 이 시간(분) 안의 것만 알림
NOTIFY_FRESH_MINUTES=60
