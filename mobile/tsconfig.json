{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./../src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../src/lib/domain/*.ts",
    "../src/lib/reports/schedule.ts"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios"
  ]
}
